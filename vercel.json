{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "framework": null,
  "rewrites": [
    { "source": "/apps/musical-cubes/:path*", "destination": "/:path*" },
    { "source": "/apps/musical-cubes", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*\\.(?:css|js|wav|svg|png|ico|json))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}